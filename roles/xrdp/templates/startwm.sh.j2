#!/bin/sh
# Ansible managed by lit.ubuntu.xrdp

if [ -r /etc/profile ]; then
  . /etc/profile
fi

{% if xrdp_desktop == 'custom' and (xrdp_custom_startwm | length) > 0 %}
{{ xrdp_custom_startwm }}
exit $?
{% endif %}

case "{{ xrdp_desktop }}" in
  gnome)
    if command -v gnome-session >/dev/null 2>&1; then
{% if xrdp_gnome_private_dbus_session | bool %}
      unset DBUS_SESSION_BUS_ADDRESS
      export XDG_SESSION_TYPE=x11
      export XDG_CURRENT_DESKTOP=ubuntu:GNOME
      export DESKTOP_SESSION={{ xrdp_gnome_session | quote }}
      exec dbus-run-session -- gnome-session --session={{ xrdp_gnome_session | quote }}
{% else %}
      exec gnome-session
{% endif %}
    fi
    ;;
  xfce)
    if command -v startxfce4 >/dev/null 2>&1; then
      exec startxfce4
    fi
    ;;
  auto|*)
    if command -v gnome-session >/dev/null 2>&1; then
{% if xrdp_gnome_private_dbus_session | bool %}
      unset DBUS_SESSION_BUS_ADDRESS
      export XDG_SESSION_TYPE=x11
      export XDG_CURRENT_DESKTOP=ubuntu:GNOME
      export DESKTOP_SESSION={{ xrdp_gnome_session | quote }}
      exec dbus-run-session -- gnome-session --session={{ xrdp_gnome_session | quote }}
{% else %}
      exec gnome-session
{% endif %}
    fi
    if command -v startxfce4 >/dev/null 2>&1; then
      exec startxfce4
    fi
    ;;
esac

if command -v xterm >/dev/null 2>&1; then
  exec xterm
fi

echo "No supported desktop session found for XRDP."
exit 1
