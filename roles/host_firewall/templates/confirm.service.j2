[Unit]
Description=Confirm rollback-protected lit host firewall transaction
ConditionPathExists={{ host_firewall_pending_config_path }}
ConditionPathExists={{ host_firewall_confirmation_request_path }}
OnFailure={{ host_firewall_rollback_service_name }}
After=local-fs.target

[Service]
Type=oneshot
ExecStart={{ host_firewall_confirmation_script_path }}
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectSystem=strict
ReadWritePaths={{ host_firewall_state_directory }} {{ host_firewall_persistent_config_path | dirname }} {{ host_firewall_systemd_unit_directory }}
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
