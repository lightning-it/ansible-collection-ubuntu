#!/usr/bin/env bash
set -euo pipefail
umask 077

runtime_backup='{{ host_firewall_runtime_backup_path }}'
runtime_backup_state='{{ host_firewall_runtime_backup_state_path }}'
persistent_backup='{{ host_firewall_persistent_backup_path }}'
persistent_state='{{ host_firewall_persistent_state_path }}'
persistent_include='{{ host_firewall_persistent_include_path }}'
pending_metadata='{{ host_firewall_pending_metadata_path }}'
rollback_record='{{ host_firewall_rollback_record_path }}'
confirmation_record='{{ host_firewall_confirmation_path }}'
transaction_lock='{{ host_firewall_transaction_lock_path }}'
nft_binary='{{ host_firewall_nft_binary }}'
systemctl_binary='{{ host_firewall_systemctl_binary }}'
flock_binary='{{ host_firewall_flock_binary }}'
rollback_timer='{{ host_firewall_rollback_timer_name }}'
expected_metadata_sha256='{{ host_firewall_pending_metadata_sha256 }}'
expected_runtime_backup_sha256='{{ host_firewall_runtime_backup_sha256 }}'
expected_runtime_state_sha256='{{ host_firewall_runtime_backup_state_sha256 }}'
expected_persistent_state_sha256='{{ host_firewall_persistent_state_sha256 }}'
expected_persistent_backup_sha256='{{ host_firewall_persistent_backup_sha256 }}'

exec 9>"${transaction_lock}"
"${flock_binary}" --exclusive 9

test -s "${pending_metadata}"
test "$(/usr/bin/sha256sum "${pending_metadata}" | /usr/bin/cut --delimiter=' ' --fields=1)" = \
  "${expected_metadata_sha256}"
test "$(/usr/bin/sha256sum "${runtime_backup}" | /usr/bin/cut --delimiter=' ' --fields=1)" = \
  "${expected_runtime_backup_sha256}"
test "$(/usr/bin/sha256sum "${runtime_backup_state}" | /usr/bin/cut --delimiter=' ' --fields=1)" = \
  "${expected_runtime_state_sha256}"
test "$(/usr/bin/sha256sum "${persistent_state}" | /usr/bin/cut --delimiter=' ' --fields=1)" = \
  "${expected_persistent_state_sha256}"
"{{ host_firewall_python_binary }}" -c 'import json,sys; value=json.load(sys.stdin); assert isinstance(value,dict)' \
  < "${pending_metadata}"
"${nft_binary}" --check --file "${runtime_backup}"

persistent_before="$(tr -d '\r\n' < "${persistent_state}")"
case "${persistent_before}" in
  present)
    test -s "${persistent_backup}"
    test "$(/usr/bin/sha256sum "${persistent_backup}" | /usr/bin/cut --delimiter=' ' --fields=1)" = \
      "${expected_persistent_backup_sha256}"
    /usr/bin/install --owner=root --group=root --mode=0600 \
      "${persistent_backup}" "${persistent_include}"
    ;;
  absent)
    test "${expected_persistent_backup_sha256}" = 'absent'
    /usr/bin/rm --force -- "${persistent_include}"
    ;;
  *)
    echo "Invalid role-owned persistent include state marker" >&2
    exit 1
    ;;
esac

# The replay file contains only destroy/recreate operations for the role-owned table.
"${nft_binary}" --file "${runtime_backup}"
/usr/bin/rm --force -- "${confirmation_record}"
"${systemctl_binary}" disable --now "${rollback_timer}"
rolled_back_at="$(/usr/bin/date --utc '+%Y-%m-%dT%H:%M:%SZ')"
/usr/bin/printf \
  '{"schema":"lit.host_firewall.rollback/v2","change_id":"%s","target":"%s","rolled_back_at":"%s"}\n' \
  '{{ host_firewall_change_id }}' '{{ host_firewall_expected_inventory_hostname }}' "${rolled_back_at}" \
  > "${rollback_record}"
/usr/bin/chmod 0600 "${rollback_record}"
