#!/usr/sbin/nft -f
# Managed by lit.ubuntu.host_firewall. Local changes are overwritten.
# Mode: {{ host_firewall_mode }}
# Policy fingerprint: {{ host_firewall_policy_fingerprint }}

# Replacing only the role-owned table keeps Podman/Netavark tables intact.
# destroy is idempotent and the complete file is one atomic nft transaction.
destroy table {{ host_firewall_table_family }} {{ host_firewall_table_name }}

table {{ host_firewall_table_family }} {{ host_firewall_table_name }} {
    set host_ipv4_addresses {
        type ipv4_addr
        elements = { {{ host_firewall_host_ipv4_addresses_effective | join(', ') }} }
    }

    set management_sources_v4 {
        type ipv4_addr
        flags interval
        elements = { {{ host_firewall_management_source_cidrs_effective | join(', ') }} }
    }

    set management_tcp_ports {
        type inet_service
        elements = { {{ host_firewall_management_tcp_ports_effective | join(', ') }} }
    }

    set tang_consumers_v4 {
        type ipv4_addr
        flags interval
        elements = { {{ host_firewall_tang_consumer_cidrs | join(', ') }} }
    }

    set container_interfaces {
        type ifname
        elements = {
{% for interface in host_firewall_container_interfaces %}
            "{{ interface }}"{{ "," if not loop.last else "" }}
{% endfor %}
        }
    }

    chain input {
        type filter hook input priority {{ host_firewall_input_priority }}; policy drop;

        counter comment "lit-host-firewall policy={{ host_firewall_policy_fingerprint }} mode={{ host_firewall_mode }}"
        iifname "lo" accept
        ct state invalid drop

        # IPv6 remains denied except for the minimum control-plane ICMPv6 needed for correct local link behaviour.
        meta nfproto ipv6 icmpv6 type {
            destination-unreachable,
            packet-too-big,
            time-exceeded,
            parameter-problem
        } accept
        meta nfproto ipv6 ip6 hoplimit 255 icmpv6 type {
            nd-router-solicit,
            nd-router-advert,
            nd-neighbor-solicit,
            nd-neighbor-advert
        } accept
        meta nfproto ipv6 icmpv6 type echo-request limit rate 10/second burst 20 packets accept
        meta nfproto ipv6 counter drop

        ct state { established, related } accept

        meta nfproto ipv4 icmp type {
            destination-unreachable,
            time-exceeded,
            parameter-problem
        } accept
        meta nfproto ipv4 icmp type echo-request limit rate 10/second burst 20 packets accept

        iifname { "{{ host_firewall_public_interface }}", "{{ host_firewall_management_interface }}" } ip saddr @management_sources_v4 ip daddr @host_ipv4_addresses tcp dport @management_tcp_ports ct state new accept

        # Tang is an explicit public service and is never exposed through the management interface.
        iifname "{{ host_firewall_public_interface }}" ip saddr @tang_consumers_v4 ip daddr {{ host_firewall_expected_public_ipv4 }} tcp dport 80 ct state new accept

        counter drop
    }

    chain container_guard {
        # New container/application forwarding is deliberately closed until a separately reviewed rule is added.
        counter drop
    }

    chain forward {
        # This later-priority guard is still evaluated after an earlier Podman/Netavark accept verdict.
        type filter hook forward priority {{ host_firewall_forward_priority }}; policy drop;

        ct state invalid drop
        meta nfproto ipv6 counter drop
        iifname "{{ host_firewall_management_interface }}" counter drop
        oifname "{{ host_firewall_management_interface }}" counter drop
        iifname @container_interfaces goto container_guard
        oifname @container_interfaces goto container_guard
        ct state { established, related } accept
        counter drop
    }

    chain output {
        type filter hook output priority {{ host_firewall_output_priority }}; policy accept;
    }
}
