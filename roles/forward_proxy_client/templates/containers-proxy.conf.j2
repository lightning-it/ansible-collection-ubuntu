# Managed by lit.ubuntu.forward_proxy_client. Local changes are overwritten.
[containers]
http_proxy = true
env = [
  "http_proxy={{ forward_proxy_client_container_url }}",
  "https_proxy={{ forward_proxy_client_container_url }}",
  "HTTP_PROXY={{ forward_proxy_client_container_url }}",
  "HTTPS_PROXY={{ forward_proxy_client_container_url }}",
  "no_proxy={{ forward_proxy_client_no_proxy | join(',') }}",
  "NO_PROXY={{ forward_proxy_client_no_proxy | join(',') }}",
]
